{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Flowsta Vault",
  "version": "0.6.1-beta3",
  "identifier": "com.flowsta.vault",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1421",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Flowsta Vault",
        "width": 1100,
        "height": 750,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "dmg", "app", "nsis", "msi"],
    "externalBin": [
      "binaries/vault-holochain",
      "binaries/vault-lair-keystore"
    ],
    "resources": [
      "resources/flowsta_private_v1_11_happ.happ",
      "resources/flowsta_identity_v1_4_happ.happ",
      "resources/flowsta_signing_v1_4_happ.happ"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": null,
      "entitlements": "entitlements.plist",
      "hardenedRuntime": true,
      "infoPlist": "installer/Info.macos.plist"
    },
    "linux": {
      "deb": {
        "files": {
          "/usr/share/applications/flowsta-vault-sign.desktop": "installer/flowsta-vault-sign.desktop"
        }
      }
    },
    "windows": {
      "signCommand": {
        "cmd": "pwsh",
        "args": ["-ExecutionPolicy", "Bypass", "-File", "scripts/sign-windows.ps1", "%1"]
      },
      "nsis": {
        "installerHooks": "installer/windows-hooks.nsh"
      }
    }
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
