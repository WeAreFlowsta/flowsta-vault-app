{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Flowsta Vault",
  "version": "0.2.0",
  "identifier": "com.flowsta.vault",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1421",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Flowsta Vault",
        "width": 1100,
        "height": 750,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/holochain",
      "binaries/lair-keystore"
    ],
    "resources": [
      "resources/flowsta_private_v1_10_happ.happ",
      "resources/flowsta_identity_v1_3_happ.happ"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": null,
      "entitlements": "entitlements.plist",
      "hardenedRuntime": true
    }
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
