# Flowsta Vault environment variables
# Copy to .env and update for your environment

# Frontend (Vite)
VITE_API_URL=https://auth-api.flowsta.com
VITE_WEB_URL=https://flowsta.com

# Rust (compile-time) — also set in .cargo/config.toml
FLOWSTA_API_URL=https://auth-api.flowsta.com
FLOWSTA_BOOTSTRAP_URL=https://bootstrap.flowsta.com
FLOWSTA_SIGNAL_URL=wss://bootstrap.flowsta.com
